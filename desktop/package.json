{
  "name": "nebuladrive-desktop",
  "version": "1.2.0",
  "description": "NebulaDrive desktop app: your private cloud on your PC, no servers, no subscriptions.",
  "main": "main.js",
  "author": "Makerxm800",
  "private": true,
  "scripts": {
    "prepare-app": "node scripts/prepare.js",
    "start": "npm run prepare-app && electron .",
    "smoke": "npm run prepare-app && electron . --smoke",
    "dist:win": "npm run prepare-app && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run prepare-app && electron-builder --mac --universal --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jszip": "^3.10.1"
  },
  "build": {
    "appId": "com.makerxm800.nebuladrive",
    "productName": "NebulaDrive",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "app/**/*", "build/icon.png", "package.json"],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NebulaDrive",
      "artifactName": "NebulaDrive-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NebulaDrive-${version}-portable.${ext}"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "NebulaDrive-${version}-mac.${ext}"
    }
  }
}
